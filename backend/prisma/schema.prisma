// Maps platform - relational + geospatial model (PostgreSQL + PostGIS).
//
// Geometry columns use PostGIS types (SRID 4326, WGS84 lon/lat). Prisma has no
// native geometry type, so they are declared as `Unsupported(...)` and are read
// and written through the repositories in `src/modules/**/infrastructure`
// using parameterised raw SQL (ST_GeomFromGeoJSON / ST_AsGeoJSON).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extension-less relative imports, as expected by the CommonJS TypeScript build
  // (explicit, so generation does not depend on finding tsconfig.json).
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum UserRole {
  USER
  ADMIN
}

enum RoutingProfile {
  CAR
  TRUCK
  MOTORCYCLE
  BICYCLE
  PEDESTRIAN
}

enum GeofenceType {
  CIRCLE
  POLYGON
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
  OTHER
}

enum RoutePointType {
  ORIGIN
  WAYPOINT
  DESTINATION
}

enum DownloadedRegionStatus {
  DOWNLOADED
  DELETED
}

enum SyncEventStatus {
  APPLIED
  DUPLICATE
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  devices           Device[]
  routes            Route[]
  trips             Trip[]
  places            Place[]
  favoritePlaces    FavoritePlace[]
  geofences         Geofence[]
  downloadedRegions DownloadedRegion[]
  syncEvents        SynchronizationEvent[]
  routeTombstones   RouteTombstone[]

  @@map("users")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  /// Stable identifier generated by the mobile app on first launch.
  installationId String         @map("installation_id")
  platform       DevicePlatform @default(OTHER)
  model          String?
  appVersion     String?        @map("app_version")
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips             Trip[]
  downloadedRegions DownloadedRegion[]
  syncEvents        SynchronizationEvent[]

  @@unique([userId, installationId])
  @@map("devices")
}

/// Offline map region: a PMTiles file (visual map) plus an optional routing
/// package. Files live in MAP_STORAGE_PATH / ROUTING_STORAGE_PATH, never in the DB.
model MapRegion {
  id              String                                 @id @default(uuid()) @db.Uuid
  /// Public identifier used in URLs, e.g. "guayaquil".
  code            String                                 @unique
  name            String
  /// ISO 3166-1 alpha-2 country code.
  country         String                                 @db.VarChar(2)
  province        String?
  city            String?
  /// Data version, e.g. "2026.09.01".
  version         String
  /// Path of the PMTiles file relative to MAP_STORAGE_PATH.
  fileName        String                                 @map("file_name")
  fileSize        BigInt                                 @map("file_size")
  /// SHA-256 (hex) of the PMTiles file.
  checksum        String
  boundingBox     Unsupported("geometry(Polygon, 4326)")? @map("bounding_box")
  minZoom         Int                                    @default(0) @map("min_zoom")
  maxZoom         Int                                    @default(14) @map("max_zoom")
  /// Optional absolute URL (e.g. a CDN). When null the API download endpoint is used.
  downloadUrl     String?                                @map("download_url")
  /// Routing package (Valhalla tile archive) relative to ROUTING_STORAGE_PATH.
  routingFile     String?                                @map("routing_file")
  routingFileSize BigInt?                                @map("routing_file_size")
  routingChecksum String?                                @map("routing_checksum")
  enabled         Boolean                                @default(true)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  downloads DownloadedRegion[]

  @@index([boundingBox], type: Gist)
  @@map("map_regions")
}

/// Which region/version a device has stored locally (reported by the app through sync).
model DownloadedRegion {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  deviceId     String                 @map("device_id") @db.Uuid
  regionId     String                 @map("region_id") @db.Uuid
  version      String
  status       DownloadedRegionStatus @default(DOWNLOADED)
  downloadedAt DateTime               @default(now()) @map("downloaded_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  region MapRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([deviceId, regionId])
  @@index([userId])
  @@map("downloaded_regions")
}

model Place {
  id          String                               @id @default(uuid()) @db.Uuid
  /// Null for shared/global places managed by administrators.
  userId      String?                              @map("user_id") @db.Uuid
  name        String
  description String?
  category    String?
  address     String?
  location    Unsupported("geometry(Point, 4326)")
  createdAt   DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites FavoritePlace[]

  @@index([userId])
  @@index([location], type: Gist)
  @@map("places")
}

model FavoritePlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  /// User label, e.g. "Casa" or "Trabajo".
  alias     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@map("favorite_places")
}

model Route {
  id              String                                    @id @default(uuid()) @db.Uuid
  userId          String                                    @map("user_id") @db.Uuid
  name            String
  profile         RoutingProfile
  origin          Unsupported("geometry(Point, 4326)")
  destination     Unsupported("geometry(Point, 4326)")
  distanceMeters  Float                                     @map("distance_meters")
  durationSeconds Float                                     @map("duration_seconds")
  geometry        Unsupported("geometry(LineString, 4326)")
  /// Normalised turn-by-turn instructions (RouteStep[]).
  steps           Json                                      @default("[]")
  regionCode      String?                                   @map("region_code")
  provider        String?
  createdAt       DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  points RoutePoint[]
  trips  Trip[]

  @@index([userId, createdAt])
  /// Change feed of `GET /sync/pull`, ordered by (updated_at, id).
  @@index([userId, updatedAt, id])
  @@index([geometry], type: Gist)
  @@map("routes")
}

/// Saved routes that were deleted, so `GET /sync/pull` tells the user's other
/// devices to remove them. A route id is either in `routes` or here, never in
/// both: saving the route again removes its tombstone.
model RouteTombstone {
  userId    String   @map("user_id") @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  deletedAt DateTime @default(now()) @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
  @@index([userId, deletedAt, routeId])
  @@map("route_tombstones")
}

/// Ordered stops of a route (origin, waypoints, destination). Prepared for multi-stop routing.
model RoutePoint {
  id       String                               @id @default(uuid()) @db.Uuid
  routeId  String                               @map("route_id") @db.Uuid
  sequence Int
  type     RoutePointType
  name     String?
  location Unsupported("geometry(Point, 4326)")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@map("route_points")
}

model Trip {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  deviceId       String?        @map("device_id") @db.Uuid
  routeId        String?        @map("route_id") @db.Uuid
  name           String?
  profile        RoutingProfile @default(CAR)
  status         TripStatus     @default(ACTIVE)
  startedAt      DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?      @map("ended_at") @db.Timestamptz(3)
  distanceMeters Float?         @map("distance_meters")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  route  Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  points TripPoint[]

  @@index([userId, startedAt])
  @@map("trips")
}

/// GPS fix recorded during a trip. (trip_id, recorded_at) is unique so that
/// retried uploads from the offline queue are idempotent.
model TripPoint {
  id         String                               @id @default(uuid()) @db.Uuid
  tripId     String                               @map("trip_id") @db.Uuid
  location   Unsupported("geometry(Point, 4326)")
  accuracy   Float?
  speed      Float?
  heading    Float?
  altitude   Float?
  recordedAt DateTime                             @map("recorded_at") @db.Timestamptz(3)
  receivedAt DateTime                             @default(now()) @map("received_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, recordedAt])
  @@index([location], type: Gist)
  @@map("trip_points")
}

model Geofence {
  id           String                                 @id @default(uuid()) @db.Uuid
  userId       String                                 @map("user_id") @db.Uuid
  name         String
  description  String?
  type         GeofenceType
  /// Only for CIRCLE geofences.
  center       Unsupported("geometry(Point, 4326)")?
  radiusMeters Float?                                 @map("radius_meters")
  /// Always populated: the polygon itself, or the circle approximated as a polygon.
  area         Unsupported("geometry(Polygon, 4326)")
  metadata     Json?
  active       Boolean                                @default(true)
  createdAt    DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([area], type: Gist)
  @@map("geofences")
}

/// Audit/idempotency log of operations pushed by offline clients.
model SynchronizationEvent {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  deviceId          String?         @map("device_id") @db.Uuid
  /// Client generated id of the queued operation (idempotency key).
  clientOperationId String          @map("client_operation_id")
  entity            String
  operation         String
  payload           Json
  status            SyncEventStatus
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  clientCreatedAt   DateTime?       @map("client_created_at") @db.Timestamptz(3)
  processedAt       DateTime        @default(now()) @map("processed_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([userId, clientOperationId])
  @@index([userId, processedAt])
  @@map("synchronization_events")
}
