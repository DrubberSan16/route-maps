// Maps platform - relational + geospatial model (PostgreSQL + PostGIS).
//
// Geometry columns use PostGIS types (SRID 4326, WGS84 lon/lat). Prisma has no
// native geometry type, so they are declared as `Unsupported(...)` and are read
// and written through the repositories in `src/modules/**/infrastructure`
// using parameterised raw SQL (ST_GeomFromGeoJSON / ST_AsGeoJSON).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extension-less relative imports, as expected by the CommonJS TypeScript build
  // (explicit, so generation does not depend on finding tsconfig.json).
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

/// USER: the app's people. OPERATOR: operations in the administration panel (monitoring, trips,
/// geofences, places). ADMIN: everything, including accounts, integrations and region publishing.
enum UserRole {
  USER
  OPERATOR
  ADMIN
}

enum RoutingProfile {
  CAR
  TRUCK
  MOTORCYCLE
  BICYCLE
  PEDESTRIAN
}

enum GeofenceType {
  CIRCLE
  POLYGON
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
  OTHER
}

enum RoutePointType {
  ORIGIN
  WAYPOINT
  DESTINATION
}

enum DownloadedRegionStatus {
  DOWNLOADED
  DELETED
}

enum SyncEventStatus {
  APPLIED
  DUPLICATE
  FAILED
}

/// Events an integration receives besides the platform's own (regions published or disabled).
enum IntegrationEventScope {
  /// Those of the account it acts as.
  ACCOUNT
  /// Those of every account (an ERP or a reporting tool of the whole fleet). Its API keys still
  /// act as its own account only.
  ALL_ACCOUNTS
}

enum WebhookDeliveryStatus {
  PENDING
  SENDING
  SUCCEEDED
  FAILED
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String
  role              UserRole  @default(USER)
  /// Disabled accounts cannot log in, and their open sessions stop working.
  active            Boolean   @default(true)
  /// Account an integration acts as: it never logs in with a password.
  serviceAccount    Boolean   @default(false) @map("service_account")
  /// Access tokens issued before this instant are refused (sessions closed by an administrator).
  sessionsRevokedAt DateTime? @map("sessions_revoked_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  devices           Device[]
  routes            Route[]
  trips             Trip[]
  places            Place[]
  favoritePlaces    FavoritePlace[]
  geofences         Geofence[]
  downloadedRegions DownloadedRegion[]
  syncEvents        SynchronizationEvent[]
  routeTombstones   RouteTombstone[]
  integrations      Integration[]
  platformEvents    PlatformEvent[]
  auditLogs         AuditLog[]

  @@index([role])
  @@map("users")
}

/// Refresh tokens are stored hashed (SHA-256) and rotated on every use.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  /// Stable identifier generated by the mobile app on first launch.
  installationId String         @map("installation_id")
  platform       DevicePlatform @default(OTHER)
  model          String?
  appVersion     String?        @map("app_version")
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips             Trip[]
  downloadedRegions DownloadedRegion[]
  syncEvents        SynchronizationEvent[]

  @@unique([userId, installationId])
  @@map("devices")
}

/// Offline map region: a PMTiles file (visual map) plus the offline pack of the
/// phone. Files live in MAP_STORAGE_PATH / ROUTING_STORAGE_PATH, never in the DB.
model MapRegion {
  id              String                                 @id @default(uuid()) @db.Uuid
  /// Public identifier used in URLs, e.g. "guayaquil".
  code            String                                 @unique
  name            String
  /// ISO 3166-1 alpha-2 country code.
  country         String                                 @db.VarChar(2)
  province        String?
  city            String?
  /// Data version, e.g. "2026.09.01".
  version         String
  /// Path of the PMTiles file relative to MAP_STORAGE_PATH.
  fileName        String                                 @map("file_name")
  fileSize        BigInt                                 @map("file_size")
  /// SHA-256 (hex) of the PMTiles file.
  checksum        String
  boundingBox     Unsupported("geometry(Polygon, 4326)")? @map("bounding_box")
  minZoom         Int                                    @default(0) @map("min_zoom")
  maxZoom         Int                                    @default(14) @map("max_zoom")
  /// Optional absolute URL (e.g. a CDN). When null the API download endpoint is used.
  downloadUrl     String?                                @map("download_url")
  /// Offline pack of the phone (road network and search index, .rmpack; Valhalla tiles in
  /// legacy OSM regions) relative to ROUTING_STORAGE_PATH.
  routingFile     String?                                @map("routing_file")
  routingFileSize BigInt?                                @map("routing_file_size")
  routingChecksum String?                                @map("routing_checksum")
  /// Relief, satellite and overlay archives: [{kind, file, size, checksum, minZoom, maxZoom, format}].
  assets          Json                                   @default("[]")
  enabled         Boolean                                @default(true)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  downloads DownloadedRegion[]

  @@index([boundingBox], type: Gist)
  @@map("map_regions")
}

/// Which region/version a device has stored locally (reported by the app through sync).
model DownloadedRegion {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  deviceId     String                 @map("device_id") @db.Uuid
  regionId     String                 @map("region_id") @db.Uuid
  version      String
  status       DownloadedRegionStatus @default(DOWNLOADED)
  downloadedAt DateTime               @default(now()) @map("downloaded_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  region MapRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([deviceId, regionId])
  @@index([userId])
  @@map("downloaded_regions")
}

model Place {
  id          String                               @id @default(uuid()) @db.Uuid
  /// Null for shared/global places managed by administrators.
  userId      String?                              @map("user_id") @db.Uuid
  name        String
  description String?
  category    String?
  address     String?
  location    Unsupported("geometry(Point, 4326)")
  createdAt   DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites FavoritePlace[]

  @@index([userId])
  @@index([location], type: Gist)
  @@map("places")
}

model FavoritePlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  /// User label, e.g. "Casa" or "Trabajo".
  alias     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@map("favorite_places")
}

model Route {
  id              String                                    @id @default(uuid()) @db.Uuid
  userId          String                                    @map("user_id") @db.Uuid
  name            String
  profile         RoutingProfile
  origin          Unsupported("geometry(Point, 4326)")
  destination     Unsupported("geometry(Point, 4326)")
  distanceMeters  Float                                     @map("distance_meters")
  durationSeconds Float                                     @map("duration_seconds")
  geometry        Unsupported("geometry(LineString, 4326)")
  /// Normalised turn-by-turn instructions (RouteStep[]).
  steps           Json                                      @default("[]")
  regionCode      String?                                   @map("region_code")
  provider        String?
  createdAt       DateTime                                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  points RoutePoint[]
  trips  Trip[]

  @@index([userId, createdAt])
  /// Change feed of `GET /sync/pull`, ordered by (updated_at, id).
  @@index([userId, updatedAt, id])
  @@index([geometry], type: Gist)
  @@map("routes")
}

/// Saved routes that were deleted, so `GET /sync/pull` tells the user's other
/// devices to remove them. A route id is either in `routes` or here, never in
/// both: saving the route again removes its tombstone.
model RouteTombstone {
  userId    String   @map("user_id") @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  deletedAt DateTime @default(now()) @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, routeId])
  @@index([userId, deletedAt, routeId])
  @@map("route_tombstones")
}

/// Ordered stops of a route (origin, waypoints, destination). Prepared for multi-stop routing.
model RoutePoint {
  id       String                               @id @default(uuid()) @db.Uuid
  routeId  String                               @map("route_id") @db.Uuid
  sequence Int
  type     RoutePointType
  name     String?
  location Unsupported("geometry(Point, 4326)")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@map("route_points")
}

model Trip {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  deviceId           String?        @map("device_id") @db.Uuid
  routeId            String?        @map("route_id") @db.Uuid
  name               String?
  profile            RoutingProfile @default(CAR)
  status             TripStatus     @default(ACTIVE)
  startedAt          DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?      @map("ended_at") @db.Timestamptz(3)
  distanceMeters     Float?         @map("distance_meters")
  /// Data of the client application (vehicle, driver or order ids), returned in its events.
  metadata           Json?
  /// Time of the last fix checked against the account's geofences (enter/exit events).
  geofencesCheckedAt DateTime?      @map("geofences_checked_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  route          Route?              @relation(fields: [routeId], references: [id], onDelete: SetNull)
  points         TripPoint[]
  geofenceStates TripGeofenceState[]

  @@index([userId, startedAt])
  /// Administration lists and live monitoring read trips by status and time.
  @@index([status, startedAt])
  @@map("trips")
}

/// Geofences a trip is currently inside of; a change emits geofence.entered or geofence.exited.
model TripGeofenceState {
  tripId     String   @map("trip_id") @db.Uuid
  geofenceId String   @map("geofence_id") @db.Uuid
  enteredAt  DateTime @map("entered_at") @db.Timestamptz(3)

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@id([tripId, geofenceId])
  @@index([geofenceId])
  @@map("trip_geofence_states")
}

/// GPS fix recorded during a trip. (trip_id, recorded_at) is unique so that
/// retried uploads from the offline queue are idempotent.
model TripPoint {
  id         String                               @id @default(uuid()) @db.Uuid
  tripId     String                               @map("trip_id") @db.Uuid
  location   Unsupported("geometry(Point, 4326)")
  accuracy   Float?
  speed      Float?
  heading    Float?
  altitude   Float?
  recordedAt DateTime                             @map("recorded_at") @db.Timestamptz(3)
  receivedAt DateTime                             @default(now()) @map("received_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, recordedAt])
  @@index([location], type: Gist)
  /// Recent fixes (route traffic, traffic map, activity) are read by time.
  @@index([recordedAt])
  @@map("trip_points")
}

model Geofence {
  id           String                                 @id @default(uuid()) @db.Uuid
  userId       String                                 @map("user_id") @db.Uuid
  name         String
  description  String?
  type         GeofenceType
  /// Only for CIRCLE geofences.
  center       Unsupported("geometry(Point, 4326)")?
  radiusMeters Float?                                 @map("radius_meters")
  /// Always populated: the polygon itself, or the circle approximated as a polygon.
  area         Unsupported("geometry(Polygon, 4326)")
  metadata     Json?
  active       Boolean                                @default(true)
  createdAt    DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripStates TripGeofenceState[]

  @@index([userId])
  @@index([area], type: Gist)
  @@map("geofences")
}

/// Audit/idempotency log of operations pushed by offline clients.
model SynchronizationEvent {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  deviceId          String?         @map("device_id") @db.Uuid
  /// Client generated id of the queued operation (idempotency key).
  clientOperationId String          @map("client_operation_id")
  entity            String
  operation         String
  payload           Json
  status            SyncEventStatus
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  clientCreatedAt   DateTime?       @map("client_created_at") @db.Timestamptz(3)
  processedAt       DateTime        @default(now()) @map("processed_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([userId, clientOperationId])
  @@index([userId, processedAt])
  @@map("synchronization_events")
}

/// External application connected to the platform. It acts as one account (`userId`): through its
/// API keys it reads and writes that account's trips, positions, geofences, places and routes, and
/// its webhooks receive that account's events (or every account's, see `eventScope`) plus the
/// platform's (regions).
model Integration {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  contactEmail       String?               @map("contact_email")
  userId             String                @map("user_id") @db.Uuid
  active             Boolean               @default(true)
  /// Requests per minute shared by all its keys.
  rateLimitPerMinute Int                   @default(600) @map("rate_limit_per_minute")
  /// Whose events its webhooks and `GET /events` receive.
  eventScope         IntegrationEventScope @default(ACCOUNT) @map("event_scope")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys  ApiKey[]
  webhooks WebhookEndpoint[]

  @@index([userId])
  @@map("integrations")
}

/// API key of an integration. The key is shown once; only its SHA-256 is kept.
model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  integrationId String    @map("integration_id") @db.Uuid
  name          String
  /// Public start of the key ("rmk_" + 12 hex characters), used to find it.
  prefix        String    @unique
  /// SHA-256 (hex) of the whole key.
  keyHash       String    @map("key_hash")
  /// Last characters of the key, so people can tell keys apart.
  lastFour      String    @map("last_four")
  scopes        String[]
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp    String?   @map("last_used_ip")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  integration Integration     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  usage       ApiUsageDaily[]

  @@index([integrationId])
  @@map("api_keys")
}

/// Requests made with an API key per day (in the platform's time zone).
model ApiUsageDaily {
  apiKeyId String   @map("api_key_id") @db.Uuid
  day      DateTime @db.Date
  requests Int      @default(0)
  errors   Int      @default(0)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, day])
  @@index([day])
  @@map("api_usage_daily")
}

/// URL of an integration that receives events (HTTP POST signed with HMAC-SHA256).
model WebhookEndpoint {
  id                  String    @id @default(uuid()) @db.Uuid
  integrationId       String    @map("integration_id") @db.Uuid
  url                 String
  description         String?
  /// Event types delivered; "*" for all of them.
  events              String[]
  active              Boolean   @default(true)
  /// Signing secret, encrypted (AES-256-GCM) with INTEGRATIONS_SECRET_KEY.
  secret              String
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration Integration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([integrationId])
  @@map("webhook_endpoints")
}

/// Something that happened on the platform (trip finished, geofence entered, region published),
/// kept for the administration panel, `GET /events` and webhook deliveries.
model PlatformEvent {
  id        String   @id @default(uuid()) @db.Uuid
  /// Increasing number, the cursor of `GET /events?after=`.
  seq       BigInt   @unique @default(autoincrement())
  type      String
  /// Account the event is about; null for platform events (regions).
  accountId String?  @map("account_id") @db.Uuid
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account    User?             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([createdAt])
  @@index([accountId, seq])
  @@index([type, createdAt])
  @@map("platform_events")
}

/// One event sent to one webhook endpoint, retried with increasing waits until it succeeds.
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  eventId        String                @map("event_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt       DateTime?             @map("locked_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  responseStatus Int?                  @map("response_status")
  /// Start of the receiver's answer (at most 1 KB).
  responseBody   String?               @map("response_body")
  error          String?
  durationMs     Int?                  @map("duration_ms")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    PlatformEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// What administrators and operators changed, and when.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  /// e.g. "user.update", "integration.key.create".
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  /// Name of the target at that moment (email, integration name), shown in the panel.
  summary    String
  details    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
