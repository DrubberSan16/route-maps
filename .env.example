# =============================================================================
# Maps Platform - variables de entorno
#
#   make init            -> crea .env a partir de este archivo con secretos aleatorios
#   cp .env.example .env -> alternativa manual (cambia todos los CHANGE_ME)
#
# .env nunca se sube a Git. docker-compose.yml no contiene secretos: todos los
# valores sensibles salen de este archivo.
# =============================================================================

# ---- General ----------------------------------------------------------------
# development | production (docker-compose.prod.yml fuerza production)
NODE_ENV=development
APP_PORT=3000
# Puerto del host publicado por Nginx, el único servicio expuesto.
NGINX_HTTP_PORT=8080
# Etiqueta y prefijo de las imágenes construidas.
IMAGE_PREFIX=maps-platform
IMAGE_TAG=latest

# ---- PostgreSQL + PostGIS (solo accesible dentro de maps-network) ------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=maps
DATABASE_USER=maps
# Usa letras, números y - _ . (la contraseña forma parte de la URL de conexión).
DATABASE_PASSWORD=CHANGE_ME_database_password
# Docker Compose construye la URL del backend con los valores anteriores.
# DATABASE_URL solo se usa al ejecutar el backend o Prisma fuera de Docker
# (requiere docker-compose.override.yml para acceder a PostgreSQL desde el host).
DATABASE_URL=postgresql://maps:CHANGE_ME_database_password@localhost:5432/maps?schema=public

# ---- Redis (caché; el backend sigue funcionando si no está disponible) -------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_MAXMEMORY=256mb

# ---- JWT --------------------------------------------------------------------
# Mínimo 16 caracteres; en producción mínimo 32, distintos entre sí y sin CHANGE_ME.
# Genera valores con: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_access_token_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- API --------------------------------------------------------------------
# Orígenes permitidos (separados por comas). Usa * cuando esta instalación sea
# una plataforma pública consumida directamente por aplicaciones web externas.
CORS_ORIGINS=*
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info
# true: logs legibles (pino-pretty, solo con dependencias de desarrollo).
LOG_PRETTY=false

# ---- Routing propio sobre la red vial oficial --------------------------------
ROUTING_PROVIDER=native
NATIVE_ROUTING_GRAPH_FILE=/data/native/ecuador/roads.geojson
ROUTING_LANGUAGE=es-ES
# Rutas alternativas como máximo (0 a 3).
ROUTING_MAX_ALTERNATIVES=2

# ---- Geocodificacion propia sobre localidades y POI oficiales ----------------
# native | none
GEOCODING_PROVIDER=native
NATIVE_DATA_PATH=/data/native/ecuador
GEOCODING_COUNTRY_CODES=ec
# Países y ciudades del mapa base mundial (make prepare-region REGION=world),
# buscados junto al catálogo nativo. Por defecto: <MAP_STORAGE_PATH>/world/world.places.json
# GEOCODING_PLACES_FILE=

# ---- Mapas y datos de regiones ----------------------------------------------
# Carpeta del host con maps/, routing/ e imports/ (montada en los contenedores).
STORAGE_PATH=./storage
MAP_STORAGE_PATH=/data/maps
ROUTING_STORAGE_PATH=/data/routing
PUBLIC_TILES_BASE_URL=/maps
MAP_DOWNLOAD_ACCEL_REDIRECT=true
# Memoria de Java para generar PMTiles (Ecuador completo: 4g recomendado).
TILEGEN_MEMORY=2g

# ---- Datos de demostración (desarrollo) --------------------------------------
# Crea admin@maps.local y demo@maps.local con datos de ejemplo en Guayaquil.
SEED_DEMO_DATA=true
# Vacíos = contraseñas de desarrollo Admin1234! y Demo1234! (rechazadas en producción).
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ---- Producción (docker-compose.prod.yml) ------------------------------------
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# NGINX_SERVER_CONF=./infrastructure/nginx/tls/https.conf
# TLS_CERTS_PATH=./infrastructure/nginx/certs
